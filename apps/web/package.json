{
  "name": "@umbral/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:identity": "vitest run src/lib/auth",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:identity": "playwright test --config=playwright.config.ts identity.spec.ts",
    "api:generate": "openapi-ts -f openapi-ts.config.ts",
    "api:check": "openapi-ts -f openapi-ts.config.ts && node scripts/check-generated-client.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "jose": "^6.1.0",
    "next": ">=16.2.12 <17",
    "react": ">=19.2.7 <20",
    "react-dom": ">=19.2.7 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": ">=4.10.0 <5",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": ">=1.61.0 <2",
    "@tailwindcss/postcss": ">=4.3.3 <5",
    "@testing-library/jest-dom": ">=7.0.0 <8",
    "@testing-library/react": ">=16.3.2 <17",
    "@types/node": ">=24 <25",
    "@types/react": ">=19 <20",
    "@types/react-dom": ">=19 <20",
    "eslint": ">=10.7 <11",
    "eslint-config-next": ">=16.2.12 <17",
    "jsdom": ">=26.1.0 <27",
    "tailwindcss": ">=4.3.3 <5",
    "typescript": ">=6.0.2 <6.1",
    "vitest": ">=4.1.10 <5"
  }
}
