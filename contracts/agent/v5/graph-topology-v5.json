{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-topology-v5.json",
  "title": "ConversationGraphTopologyV5",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "topology_version", "entry", "nodes", "edges", "interrupts"],
  "properties": {
    "contract_version": {"const": "5"}, "topology_version": {"const": "conversation-topology-v5"}, "entry": {"const": "load_context"},
    "nodes": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/edge"}}, "interrupts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "confirmation"}}
  },
  "$defs": {
    "node": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"enum": ["load_context", "interpret_turn", "plan_segment", "execute_segment", "reload_context", "require_confirmation", "resolve_pending", "compose_reply", "persist_turn", "end"]}}},
    "edge": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "load_context"}, "to": {"const": "interpret_turn"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "interpret_turn"}, "to": {"const": "plan_segment"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "plan_segment"}, "to": {"const": "execute_segment"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "execute_segment"}, "to": {"const": "reload_context"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "execute_segment"}, "to": {"const": "require_confirmation"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "execute_segment"}, "to": {"const": "compose_reply"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "reload_context"}, "to": {"enum": ["require_confirmation", "compose_reply"]}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "require_confirmation"}, "to": {"const": "resolve_pending"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "resolve_pending"}, "to": {"const": "reload_context"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "compose_reply"}, "to": {"const": "persist_turn"}}},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"const": "persist_turn"}, "to": {"const": "end"}}}
      ]
    }
  },
  "examples": [{
    "contract_version": "5", "topology_version": "conversation-topology-v5", "entry": "load_context",
    "nodes": [{"name": "load_context"}, {"name": "interpret_turn"}, {"name": "plan_segment"}, {"name": "execute_segment"}, {"name": "reload_context"}, {"name": "require_confirmation"}, {"name": "resolve_pending"}, {"name": "compose_reply"}, {"name": "persist_turn"}, {"name": "end"}],
    "edges": [{"from": "load_context", "to": "interpret_turn"}, {"from": "interpret_turn", "to": "plan_segment"}, {"from": "plan_segment", "to": "execute_segment"}, {"from": "execute_segment", "to": "reload_context"}, {"from": "execute_segment", "to": "require_confirmation"}, {"from": "execute_segment", "to": "compose_reply"}, {"from": "reload_context", "to": "require_confirmation"}, {"from": "reload_context", "to": "compose_reply"}, {"from": "require_confirmation", "to": "resolve_pending"}, {"from": "resolve_pending", "to": "reload_context"}, {"from": "compose_reply", "to": "persist_turn"}, {"from": "persist_turn", "to": "end"}], "interrupts": ["confirmation"]
  }]
}
