{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-topology-v5.json",
  "title": "ConversationGraphTopologyV5",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "topology_version", "entry", "nodes", "edges", "interrupts"],
  "properties": {
    "contract_version": {"const": "5"}, "topology_version": {"const": "conversation-topology-v5"}, "entry": {"const": "load_context"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}, "interrupts": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "node": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"enum": ["load_context", "interpret_turn", "plan_segment", "execute_segment", "reload_context", "require_confirmation", "compose_reply", "persist_turn", "end"]}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "condition": {"type": "string"}}}
  },
  "examples": [{
    "contract_version": "5", "topology_version": "conversation-topology-v5", "entry": "load_context",
    "nodes": [{"name": "load_context"}, {"name": "interpret_turn"}, {"name": "plan_segment"}, {"name": "execute_segment"}, {"name": "reload_context"}, {"name": "require_confirmation"}, {"name": "compose_reply"}, {"name": "persist_turn"}, {"name": "end"}],
    "edges": [{"from": "load_context", "to": "interpret_turn"}, {"from": "interpret_turn", "to": "plan_segment"}, {"from": "plan_segment", "to": "execute_segment"}, {"from": "execute_segment", "to": "reload_context"}, {"from": "execute_segment", "to": "require_confirmation"}, {"from": "execute_segment", "to": "compose_reply"}, {"from": "reload_context", "to": "plan_segment"}, {"from": "require_confirmation", "to": "reload_context"}, {"from": "compose_reply", "to": "persist_turn"}, {"from": "persist_turn", "to": "end"}], "interrupts": ["confirmation"]
  }]
}
