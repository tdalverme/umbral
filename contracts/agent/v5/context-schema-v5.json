{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-schema-v5.json",
  "title": "TurnContextV5",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "user_id", "session_id", "active_radar_ref", "active_radar_version", "current_filters", "active_desires", "pending_action", "focused_entity", "verified_listing_refs", "allowed_capabilities", "untrusted_content", "context_schema_version", "correlation_id"],
  "properties": {
    "contract_version": {"const": "5"}, "user_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1},
    "active_radar_ref": {"type": ["string", "null"]}, "active_radar_version": {"type": ["integer", "null"], "minimum": 1},
    "current_filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}}, "active_desires": {"type": "array", "items": {"$ref": "#/$defs/desire"}},
    "pending_action": {"anyOf": [{"$ref": "#/$defs/pending_action"}, {"type": "null"}]}, "focused_entity": {"anyOf": [{"$ref": "#/$defs/focused_entity"}, {"type": "null"}]},
    "verified_listing_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "allowed_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "untrusted_content": {"type": "array", "items": {"$ref": "#/$defs/untrusted_content"}}, "context_schema_version": {"const": "5"}, "correlation_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "filter": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["filter_key", "value", "force"], "properties": {"filter_key": {"const": "budget_max"}, "value": {"type": "number"}, "force": {"const": "hard"}}},
        {"type": "object", "additionalProperties": false, "required": ["filter_key", "value", "force"], "properties": {"filter_key": {"const": "min_rooms"}, "value": {"type": "integer"}, "force": {"const": "hard"}}},
        {"type": "object", "additionalProperties": false, "required": ["filter_key", "value", "force"], "properties": {"filter_key": {"const": "zones"}, "value": {"type": "array", "maxItems": 15, "items": {"type": "string", "minLength": 1}}, "force": {"const": "hard"}}}
      ]
    },
    "desire": {"type": "object", "additionalProperties": false, "required": ["desire_ref", "raw_text", "subject_ref", "concept_links"], "properties": {"desire_ref": {"type": "string", "minLength": 1}, "raw_text": {"type": "string", "minLength": 1}, "subject_ref": {"type": "string", "minLength": 1}, "concept_links": {"type": "array", "items": {"$ref": "#/$defs/concept_link"}}}},
    "concept_link": {"type": "object", "additionalProperties": false, "required": ["concept_ref", "confidence", "force"], "properties": {"concept_ref": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "force": {"const": "soft"}}},
    "pending_action": {"type": "object", "additionalProperties": false, "required": ["pending_ref"], "properties": {"pending_ref": {"type": "string", "minLength": 1}}},
    "focused_entity": {"type": "object", "additionalProperties": false, "required": ["entity_ref"], "properties": {"entity_ref": {"type": "string", "minLength": 1}}},
    "untrusted_content": {"type": "object", "additionalProperties": false, "required": ["source", "text", "may_supply_evidence"], "properties": {"source": {"type": "string", "minLength": 1}, "text": {"type": "string"}, "may_supply_evidence": {"const": false}}}
  }
}
