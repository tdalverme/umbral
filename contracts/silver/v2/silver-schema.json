{
  "contract_version": "2",
  "normalizer_version": "silver-schema-v2",
  "enums": {
    "operation_type": ["rental"],
    "property_type": ["apartment", "house", "room", "studio", "commercial", "other"],
    "currency_type": ["ARS", "USD"],
    "geo_precision": ["exact", "block", "neighborhood", "approximate", "unknown"]
  },
  "ranges": {
    "price_value": { "gt": 0 },
    "expenses_value": { "ge": 0 },
    "title_text": { "max_length": 500 },
    "surface_m2": { "gt": 0, "max": 1000000 },
    "surface_covered_m2": { "gt": 0, "max": 1000000 },
    "rooms": { "ge": 0, "max": 200 },
    "bedrooms": { "ge": 0, "max": 100 },
    "bathrooms": { "ge": 0, "max": 100 },
    "toilettes": { "ge": 0, "max": 100 },
    "parking_spaces": { "ge": 0, "max": 100 },
    "floor": { "ge": -10, "max": 1000 },
    "age_years": { "ge": 0, "max": 1000 },
    "disposition": { "max_length": 100 },
    "orientation": { "max_length": 100 },
    "amenities": { "max_items": 100, "item_max_length": 100 },
    "description": { "max_length": 20000 },
    "media_urls": { "max_items": 50, "item_max_length": 2000 },
    "location_text": { "max_length": 500 },
    "neighborhood": { "max_length": 200 },
    "url": { "max_length": 2000 }
  },
  "errors": {
    "silver.title_too_long": "title exceeds 500 chars",
    "silver.surface_range": "surface outside (0, 1_000_000]",
    "silver.surface_covered_range": "covered surface outside (0, 1_000_000]",
    "silver.rooms_range": "rooms outside [0, 200]",
    "silver.bedrooms_range": "bedrooms outside [0, 100]",
    "silver.bathrooms_range": "bathrooms outside [0, 100]",
    "silver.toilettes_range": "toilettes outside [0, 100]",
    "silver.parking_spaces_range": "parking spaces outside [0, 100]",
    "silver.floor_range": "floor outside [-10, 1000]",
    "silver.age_years_range": "age outside [0, 1000]",
    "silver.disposition_too_long": "disposition exceeds 100 chars",
    "silver.orientation_too_long": "orientation exceeds 100 chars",
    "silver.amenities_too_long": "amenity exceeds 100 chars",
    "silver.description_too_long": "description exceeds 20_000 chars",
    "silver.media_url_invalid": "media URL is not a valid http(s) URL",
    "silver.url_invalid": "url is not a valid http(s) URL",
    "silver.currency_unsupported": "currency outside ARS/USD"
  },
  "precision_rules": {
    "address_and_coordinates": "exact",
    "coordinates_only": "block",
    "neighborhood_only": "neighborhood",
    "approximate": "approximate",
    "none": "unknown"
  },
  "change_fields": {
    "price": ["price_value", "price_currency", "expenses_value", "expenses_currency", "total_cost"],
    "text": ["title_text", "location_text", "neighborhood", "description_text", "amenities", "media_urls"],
    "attribute": ["property_type", "surface_m2", "surface_covered_m2", "rooms", "bedrooms", "bathrooms", "toilettes", "parking_spaces", "floor", "age_years", "disposition", "orientation", "operation"],
    "status": []
  }
}
