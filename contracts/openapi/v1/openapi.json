{
  "components": {
    "headers": {
      "CorrelationId": {
        "description": "Preserved or server-generated operation UUID",
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "RequestId": {
        "description": "Server-generated UUID for this request",
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "parameters": {
      "CorrelationId": {
        "description": "UUID for a multi-step operation. A valid value is preserved; when absent the runtime generates one.",
        "in": "header",
        "name": "X-Correlation-ID",
        "required": false,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Valid environment identity without access to this environment",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Missing or invalid environment identity",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      }
    },
    "schemas": {
      "AbnormalModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "signal": {
            "title": "Signal",
            "type": "string"
          }
        },
        "required": [
          "field",
          "signal",
          "detail"
        ],
        "title": "AbnormalModel",
        "type": "object"
      },
      "Body_submitImportBatch": {
        "properties": {
          "batch_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Key"
          },
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "title": "Source Version",
            "type": "string"
          }
        },
        "required": [
          "file",
          "source_id",
          "source_version",
          "contract_version"
        ],
        "title": "Body_submitImportBatch",
        "type": "object"
      },
      "CurrentSession": {
        "additionalProperties": false,
        "properties": {
          "last_activity_at": {
            "format": "date-time",
            "title": "Last Activity At",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "roles",
          "last_activity_at"
        ],
        "title": "CurrentSession",
        "type": "object"
      },
      "DependencyCheck": {
        "additionalProperties": false,
        "description": "One allowlisted readiness check.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "critical": {
            "title": "Critical",
            "type": "boolean"
          },
          "name": {
            "enum": [
              "runtime_config",
              "api",
              "postgres",
              "schema",
              "postgis",
              "pgvector",
              "redis",
              "object_storage",
              "execution_loop",
              "scheduling_loop",
              "telemetry",
              "identity_provider",
              "email_provider"
            ],
            "title": "Name",
            "type": "string"
          },
          "state": {
            "enum": [
              "ready",
              "degraded",
              "unavailable"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "critical"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "description": "Minimal liveness contract.",
        "properties": {
          "status": {
            "const": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "MagicLinkConfirmation": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "format": "uuid",
            "title": "Attempt Id",
            "type": "string"
          },
          "token_hash": {
            "maxLength": 512,
            "minLength": 32,
            "title": "Token Hash",
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "token_hash"
        ],
        "title": "MagicLinkConfirmation",
        "type": "object"
      },
      "MagicLinkRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "MagicLinkRequest",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "Sanitized RFC 9457 problem details contract.",
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "format": "uri",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "QualityResponse": {
        "additionalProperties": false,
        "properties": {
          "abnormal_distributions": {
            "items": {
              "$ref": "#/components/schemas/AbnormalModel"
            },
            "title": "Abnormal Distributions",
            "type": "array"
          },
          "counts": {
            "$ref": "#/components/schemas/RunCountsModel"
          },
          "missing_fields_by_name": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Missing Fields By Name",
            "type": "object"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "counts",
          "missing_fields_by_name",
          "abnormal_distributions"
        ],
        "title": "QualityResponse",
        "type": "object"
      },
      "QuarantineResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Id"
          },
          "record_id": {
            "format": "uuid",
            "title": "Record Id",
            "type": "string"
          },
          "rule": {
            "title": "Rule",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "run_id",
          "source_id",
          "code",
          "rule",
          "detail",
          "created_at"
        ],
        "title": "QuarantineResponse",
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "description": "Readiness response contract.",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "maxItems": 12,
            "title": "Checks",
            "type": "array"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "release_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Release Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "State",
            "type": "string"
          },
          "surface": {
            "enum": [
              "web",
              "api",
              "worker",
              "scheduler"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "surface",
          "state",
          "observed_at",
          "release_id",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "RunCountsModel": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "missing_fields": {
            "title": "Missing Fields",
            "type": "integer"
          },
          "quarantined": {
            "title": "Quarantined",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "accepted",
          "quarantined",
          "duplicates",
          "missing_fields"
        ],
        "title": "RunCountsModel",
        "type": "object"
      },
      "RunResponse": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "default": 0,
            "title": "Accepted",
            "type": "integer"
          },
          "batch_key": {
            "title": "Batch Key",
            "type": "string"
          },
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duplicates": {
            "default": 0,
            "title": "Duplicates",
            "type": "integer"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "file_format": {
            "enum": [
              "csv",
              "json"
            ],
            "title": "File Format",
            "type": "string"
          },
          "file_name": {
            "title": "File Name",
            "type": "string"
          },
          "file_sha256": {
            "title": "File Sha256",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "missing_fields": {
            "default": 0,
            "title": "Missing Fields",
            "type": "integer"
          },
          "quarantined": {
            "default": 0,
            "title": "Quarantined",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "title": "Source Version",
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "total_records": {
            "default": 0,
            "title": "Total Records",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "source_id",
          "source_version",
          "contract_version",
          "batch_key",
          "file_format",
          "file_name",
          "file_sha256",
          "state",
          "created_at"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "RuntimeVersion": {
        "additionalProperties": false,
        "description": "Immutable executing release identity.",
        "properties": {
          "artifact_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Artifact Digest",
            "type": "string"
          },
          "built_at": {
            "format": "date-time",
            "title": "Built At",
            "type": "string"
          },
          "contract_major": {
            "const": 1,
            "title": "Contract Major",
            "type": "integer"
          },
          "database_revision": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Database Revision",
            "type": "string"
          },
          "git_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "title": "Git Sha",
            "type": "string"
          },
          "manifest_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Manifest Sha256",
            "type": "string"
          },
          "release_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Release Id",
            "type": "string"
          },
          "surface": {
            "enum": [
              "web",
              "api",
              "worker",
              "scheduler"
            ],
            "title": "Surface",
            "type": "string"
          }
        },
        "required": [
          "surface",
          "release_id",
          "git_sha",
          "artifact_digest",
          "manifest_sha256",
          "contract_major",
          "database_revision",
          "built_at"
        ],
        "title": "RuntimeVersion",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "description": "Safe field-level validation metadata for RFC 9457 problems.",
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "environmentAccess": {
        "bearerFormat": "JWT",
        "description": "Environment-level operator or service identity. It is not a product user session or product authorization contract.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Foundation operational contract. Product resources will be added below /api/v1 without changing these side-effect-free probes.",
    "title": "Umbral Runtime API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutCurrentSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/magic-link-confirmations": {
      "post": {
        "operationId": "confirmMagicLink",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Magic Link",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/magic-link-requests": {
      "post": {
        "operationId": "requestMagicLink",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Magic Link",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getCurrentSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Current Session",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/imports/batches": {
      "post": {
        "operationId": "submitImportBatch",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_submitImportBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Batch rejected by the import contract"
          },
          "401": {
            "description": "Missing or invalid session"
          },
          "403": {
            "description": "Operator role required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Batch",
        "tags": [
          "Imports"
        ]
      }
    },
    "/api/v1/imports/quarantine/{record_id}": {
      "get": {
        "operationId": "getQuarantineRecord",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuarantineResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid session"
          },
          "403": {
            "description": "Operator role required"
          },
          "404": {
            "description": "Unknown record"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Quarantine Record",
        "tags": [
          "Imports"
        ]
      }
    },
