{
  "contract_version": "1",
  "registry_version": "events-v1",
  "event_types": {
    "radar.created.v1": {
      "version": 1,
      "emitted_by": "server",
      "required_keys": ["search_profile_id", "profile_version"]
    },
    "recommendation.run_published.v1": {
      "version": 1,
      "emitted_by": "server",
      "required_keys": [
        "search_profile_id",
        "run_id",
        "candidate_count",
        "published_item_count",
        "score_policy_version"
      ]
    },
    "recommendation.impression.v1": {
      "version": 1,
      "emitted_by": "client",
      "required_keys": ["search_profile_id", "run_id", "listing_id"]
    },
    "recommendation.detail_viewed.v1": {
      "version": 1,
      "emitted_by": "client",
      "required_keys": ["search_profile_id", "run_id", "listing_id"]
    },
    "listing.source_opened.v1": {
      "version": 1,
      "emitted_by": "client",
      "required_keys": ["search_profile_id", "run_id", "listing_id", "source_id"]
    }
  },
  "forbidden_keys": [
    "email",
    "phone",
    "name",
    "url",
    "ip",
    "token",
    "password",
    "description_text",
    "location_text",
    "geometry"
  ],
  "common_fields": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "actor_id",
    "correlation_id",
    "payload"
  ]
}
