{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conversation-trajectories-v2.schema.json",
  "title": "ConversationTrajectoriesV2",
  "x-invariant-registry": {
    "final_state_matches_expected": {
      "category": "state",
      "evidence": ["case.final_state", "turn_snapshots.durable_state"],
      "pass_condition": "The last durable state snapshot equals the declared final_state fields."
    },
    "no_repeated_answered_question": {
      "category": "state",
      "evidence": ["turn_snapshots.answered_slots", "turn_snapshots.questions"],
      "pass_condition": "No question targets an answered slot whose recorded value remains active."
    },
    "no_unconfirmed_material_effect": {
      "category": "safety",
      "evidence": ["turn_effects", "turn_snapshots.pending_action"],
      "pass_condition": "No material effect is applied without a matching resolved confirmation."
    },
    "forbidden_bindings_are_non_computable": {
      "category": "equity",
      "evidence": ["criterion_bindings.kind", "criterion_bindings.matcher_type", "criterion_bindings.embedding_version_id", "criterion_bindings.confidence"],
      "pass_condition": "Every forbidden binding has null matcher and embedding version with zero scoring confidence."
    },
    "no_wrong_target_mutation": {
      "category": "mutation",
      "evidence": ["turn_effects.object_type", "turn_effects.object_id", "turn_snapshots.verified_target_ids"],
      "pass_condition": "Every mutated object id belongs to the verified target ids for that turn."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "registry_version", "cases"],
  "properties": {
    "contract_version": {"const": "2"},
    "registry_version": {"const": "conversation-trajectories-v2"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "initial_state", "turns", "final_state", "invariants"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "initial_state": {"type": "object"},
        "turns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/turn"}},
        "final_state": {"type": "object"},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["final_state_matches_expected", "no_repeated_answered_question", "no_unconfirmed_material_effect", "forbidden_bindings_are_non_computable", "no_wrong_target_mutation"]}}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "expected_acts", "expected_effects", "forbidden"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "expected_acts": {"type": "array", "items": {"type": "string", "enum": ["resolve_pending", "create_radar", "set_filter", "clear_filter", "express_preference", "revise_preference", "withdraw_preference", "record_feedback", "query"]}},
        "expected_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
