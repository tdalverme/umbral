# Local/example values only. Do not use outside local development.
UMBRAL_ENV=local
UMBRAL_RELEASE_ID=foundation-local
UMBRAL_RELEASE_MANIFEST=.data/release-manifest.local.json
# UMBRAL_RELEASE_DIGEST is intentionally unset locally; it is required in preview/production.

# Local Compose services only.
DATABASE_URL=postgresql://umbral:umbral_local_only@localhost:5432/umbral
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_ROOT=.data/objects
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Local/example Compose credentials only.
POSTGRES_USER=umbral
POSTGRES_PASSWORD=local
POSTGRES_DB=umbral
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_password
IDENTITY_PROVIDER=fake
IDENTITY_ISSUER=fake://local
IDENTITY_CAPTURE_ORIGIN=http://localhost:3000
EMAIL_PROVIDER=recording
RESEND_API_KEY=
EMAIL_WEBHOOK_SECRET=
UMBRAL_BFF_TOKEN=local-bff-token
IDENTITY_FINGERPRINT_KEY=local-identity-fingerprint-key
SESSION_COOKIE_NAME=umbral_local_session
SESSION_SECURE=false
